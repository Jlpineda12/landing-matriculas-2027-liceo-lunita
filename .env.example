# Copie este archivo como .env (local) o configure las variables en GitHub:
# Settings → Secrets and variables → Actions → Variables.
# Mientras estén vacías, el píxel de Meta y la etiqueta de Google NO se cargan.

# Píxel de Meta (solo números), p. ej. 123456789012345
PUBLIC_META_PIXEL_ID=

# Etiqueta de Google: GA4 (G-XXXXXXX) o Google Ads (AW-XXXXXXXXX)
PUBLIC_GTAG_ID=

# Conversión de Google Ads al hacer clic en WhatsApp/llamar/formulario (AW-XXXXXXXXX/etiqueta)
PUBLIC_GADS_CONVERSION=

# "true" mientras sea prototipo: añade noindex (la pauta funciona igual)
PUBLIC_NOINDEX=true
