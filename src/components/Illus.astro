---
/**
 * Ilustraciones planas del mundo Lunita (SVG + CSS), para las experiencias sin foto.
 * Se animan solo cuando están en pantalla (clase .live que pone landing.ts) y respetan movimiento reducido.
 *   kind: 'vr' | 'rocket' | 'pool' | 'preicfes'
 */
interface Props { kind: 'vr' | 'rocket' | 'pool' | 'preicfes'; label: string }
const { kind, label } = Astro.props;
const spark = (x: number, y: number, s: number, c: string, i: number) =>
  `<path class="tw" style="--i:${i}" transform="translate(${x} ${y}) scale(${s})" d="M0-10l2.6 7.4L10 0l-7.4 2.6L0 10l-2.6-7.4L-10 0l7.4-2.6z" fill="${c}"/>`;
---

<svg class={`illus illus-${kind}`} viewBox="0 0 320 200" role="img" aria-label={label} data-live>
  {kind === 'vr' && (
    <Fragment>
      <circle cx="160" cy="104" r="88" fill="#f6e9ff" />
      <g class="orb"><circle cx="160" cy="104" r="76" fill="none" stroke="#ce82ff" stroke-width="2" stroke-dasharray="3 9" opacity=".7" /><circle cx="236" cy="104" r="9" fill="#1cb0f6" /></g>
      <g class="cube">
        <path d="M66 52l18-10 18 10-18 10z" fill="#ffd27a" /><path d="M66 52v20l18 10V62z" fill="#ff9600" /><path d="M102 52v20L84 82V62z" fill="#e08600" />
      </g>
      <g class="pyr"><path d="M246 40l16 30h-32z" fill="#58cc02" /><path d="M246 40l16 30h-14z" fill="#46a302" /></g>
      <g class="vr">
        <rect x="96" y="92" width="128" height="70" rx="30" fill="#7b35b8" transform="translate(0 7)" />
        <rect x="96" y="92" width="128" height="70" rx="30" fill="#ce82ff" />
        <path d="M96 118h-14a8 8 0 0 0 0 16h14M224 118h14a8 8 0 0 1 0 16h-14" fill="none" stroke="#7b35b8" stroke-width="8" stroke-linecap="round" />
        <rect x="108" y="104" width="44" height="40" rx="16" fill="#0f1747" /><rect x="168" y="104" width="44" height="40" rx="16" fill="#0f1747" />
        <path class="glint" d="M116 112l14 0M176 112l14 0" stroke="#a9e2ff" stroke-width="5" stroke-linecap="round" />
        <circle cx="160" cy="124" r="5" fill="#ffc800" />
      </g>
      <Fragment set:html={spark(58, 132, 1, '#ffc800', 0) + spark(270, 140, 0.8, '#1cb0f6', 1) + spark(214, 34, 0.7, '#ff86d0', 2)} />
    </Fragment>
  )}

  {kind === 'rocket' && (
    <Fragment>
      <circle cx="160" cy="104" r="88" fill="#ddf4ff" />
      <path d="M40 200a120 60 0 0 1 240 0z" fill="#ffc800" /><path d="M60 200a100 46 0 0 1 200 0z" fill="#ffd84d" />
      <circle cx="110" cy="182" r="9" fill="#e5a400" opacity=".5" /><circle cx="200" cy="176" r="6" fill="#e5a400" opacity=".5" />
      <g class="trail"><circle cx="160" cy="168" r="6" fill="#fff" /><circle cx="150" cy="182" r="8" fill="#fff" /><circle cx="172" cy="186" r="7" fill="#fff" /></g>
      <g class="rocket">
        <g class="flame"><path d="M148 140q12 34 12 34t12-34z" fill="#ff9600" /><path d="M153 140q7 20 7 20t7-20z" fill="#ffc800" /></g>
        <path d="M144 118l-16 22h20zM176 118l16 22h-20z" fill="#ff4b4b" />
        <path d="M160 34c22 18 26 58 18 106h-36c-8-48-4-88 18-106z" fill="#fff" stroke="#d6d6d6" stroke-width="2" />
        <path d="M160 34c10 8 16 20 19 34h-38c3-14 9-26 19-34z" fill="#1cb0f6" />
        <circle cx="160" cy="88" r="12" fill="#0f1747" /><circle cx="160" cy="88" r="7" fill="#a9e2ff" />
        <rect x="155" y="112" width="10" height="28" rx="5" fill="#ff4b4b" />
      </g>
      <Fragment set:html={spark(76, 60, 1, '#ffc800', 0) + spark(250, 52, 0.9, '#303296', 1) + spark(240, 120, 0.7, '#ce82ff', 2) + spark(92, 118, 0.6, '#1cb0f6', 3)} />
    </Fragment>
  )}

  {kind === 'pool' && (
    <Fragment>
      <rect x="20" y="20" width="280" height="170" rx="34" fill="#ddf4ff" />
      <g class="sun"><circle cx="262" cy="52" r="18" fill="#ffc800" /><circle cx="262" cy="52" r="26" fill="none" stroke="#ffc800" stroke-width="3" stroke-dasharray="4 7" /></g>
      <path d="M20 96h280" stroke="#fff" stroke-width="4" stroke-dasharray="14 10" />
      <g class="lane">{[0, 1, 2, 3, 4, 5, 6, 7].map((i) => <circle cx={40 + i * 34} cy="96" r="6" fill={i % 2 ? '#ff4b4b' : '#fff'} />)}</g>
      <clipPath id="pool-clip"><rect x="20" y="20" width="280" height="170" rx="34" /></clipPath>
      <g clip-path="url(#pool-clip)">
        <path class="wave w1" d="M-40 120q20-10 40 0t40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0V200H-40z" fill="#1cb0f6" opacity=".55" />
        <g class="ring">
          <circle cx="160" cy="126" r="30" fill="none" stroke="#fff" stroke-width="16" />
          <circle cx="160" cy="126" r="30" fill="none" stroke="#ff4b4b" stroke-width="16" stroke-dasharray="23.6 23.6" />
          <path d="M150 92a20 20 0 1 0 18 30 16 16 0 0 1-18-30z" fill="#ffc800" />
          <path d="m168 92 1.8 4 4.2.4-3.2 2.8 1 4.2-3.8-2.2-3.8 2.2 1-4.2-3.2-2.8 4.2-.4z" fill="#ffc800" />
        </g>
        <path class="wave w2" d="M-40 140q20-10 40 0t40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0 40 0V200H-40z" fill="#1899d6" opacity=".8" />
        <g class="bub"><circle cx="96" cy="176" r="5" fill="#fff" opacity=".8" /><circle cx="230" cy="180" r="4" fill="#fff" opacity=".8" /><circle cx="120" cy="186" r="3" fill="#fff" opacity=".8" /></g>
      </g>
    </Fragment>
  )}

  {kind === 'preicfes' && (
    <Fragment>
      <circle cx="160" cy="104" r="88" fill="#e5f8d4" />
      <g class="sheet">
        <rect x="58" y="34" width="112" height="146" rx="14" fill="#46a302" transform="translate(0 6)" />
        <rect x="58" y="34" width="112" height="146" rx="14" fill="#fff" stroke="#d6d6d6" stroke-width="2" />
        <rect x="74" y="48" width="56" height="8" rx="4" fill="#58cc02" />
        {[0, 1, 2, 3, 4].map((r) => [0, 1, 2, 3].map((c) => (
          <circle class:list={['bb', { fill: c === [1, 3, 0, 2, 1][r] }]} style={`--i:${r}`} cx={84 + c * 22} cy={78 + r * 20} r="7" fill={c === [1, 3, 0, 2, 1][r] ? '#0f1747' : 'none'} stroke="#0f1747" stroke-width="2" />
        )))}
      </g>
      <g class="bars">
        <rect class="bar" style="--i:0" x="196" y="128" width="20" height="40" rx="6" fill="#ffc800" />
        <rect class="bar" style="--i:1" x="222" y="104" width="20" height="64" rx="6" fill="#1cb0f6" />
        <rect class="bar" style="--i:2" x="248" y="76" width="20" height="92" rx="6" fill="#58cc02" />
      </g>
      <path class="arrow" d="M192 112l26-20 22 10 34-34" fill="none" stroke="#ff4b4b" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" pathLength="1" />
      <path class="arrow-h" d="M262 66l14-4-4 14" fill="none" stroke="#ff4b4b" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
      <Fragment set:html={spark(282, 40, 0.9, '#ffc800', 0) + spark(44, 150, 0.7, '#ce82ff', 1)} />
    </Fragment>
  )}
</svg>

<style is:global>
  .illus { display: block; width: 100%; height: auto; overflow: visible; }
  .illus * { transform-box: fill-box; transform-origin: center; }
  .illus .tw { transform-box: view-box; }
  @media (prefers-reduced-motion: no-preference) {
    .illus.live .tw { animation: il-tw 2.4s calc(var(--i) * -0.6s) ease-in-out infinite; transform-box: fill-box; }
    /* Realidad virtual */
    .illus.live .vr { animation: il-bob 3.2s ease-in-out infinite; }
    .illus.live .glint { animation: il-glint 2.8s ease-in-out infinite; }
    .illus.live .cube { animation: il-float 4s ease-in-out infinite; }
    .illus.live .pyr { animation: il-float 3.4s -1.2s ease-in-out infinite; }
    .illus.live .orb { transform-box: view-box; transform-origin: 160px 104px; animation: il-spin 9s linear infinite; }
    /* Cohete */
    .illus.live .rocket { animation: il-hover 2.6s ease-in-out infinite; }
    .illus.live .flame { transform-origin: top; animation: il-flame 0.32s ease-in-out infinite alternate; }
    .illus.live .trail circle { animation: il-puff 1.6s ease-out infinite; }
    .illus.live .trail circle:nth-child(2) { animation-delay: -0.5s; } .illus.live .trail circle:nth-child(3) { animation-delay: -1s; }
    /* Piscina */
    .illus.live .w1 { animation: il-wave 3.2s linear infinite; }
    .illus.live .w2 { animation: il-wave 2.4s linear infinite reverse; }
    .illus.live .ring { animation: il-ring 2.8s ease-in-out infinite; }
    .illus.live .bub circle { animation: il-bub 2.6s ease-in infinite; }
    .illus.live .bub circle:nth-child(2) { animation-delay: -0.9s; } .illus.live .bub circle:nth-child(3) { animation-delay: -1.7s; }
    .illus.live .sun { animation: il-spin 14s linear infinite; }
    /* PREICFES */
    .illus.live .bb.fill { animation: il-pop 0.5s calc(0.2s + var(--i) * 0.18s) cubic-bezier(.34, 1.56, .64, 1) both; }
    .illus.live .bar { transform-origin: bottom; animation: il-grow 0.9s calc(0.4s + var(--i) * 0.15s) cubic-bezier(.34, 1.56, .64, 1) both; }
    .illus.live .arrow { stroke-dasharray: 1; animation: il-draw 1s 1s ease-out both; }
    .illus.live .arrow-h { animation: il-pop 0.4s 1.9s cubic-bezier(.34, 1.56, .64, 1) both; }
  }
  @keyframes il-tw { 0%, 100% { scale: 0.6; opacity: 0.5; } 50% { scale: 1.15; opacity: 1; } }
  @keyframes il-bob { 0%, 100% { transform: translateY(0) rotate(-2deg); } 50% { transform: translateY(-8px) rotate(2deg); } }
  @keyframes il-glint { 0%, 70%, 100% { opacity: 0.4; } 80% { opacity: 1; } }
  @keyframes il-float { 0%, 100% { transform: translateY(0) rotate(0); } 50% { transform: translateY(-10px) rotate(12deg); } }
  @keyframes il-spin { to { transform: rotate(360deg); } }
  @keyframes il-hover { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
  @keyframes il-flame { from { transform: scaleY(0.8); } to { transform: scaleY(1.15); } }
  @keyframes il-puff { from { transform: translateY(0) scale(0.6); opacity: 1; } to { transform: translateY(18px) scale(1.4); opacity: 0; } }
  @keyframes il-wave { to { transform: translateX(-80px); } }
  @keyframes il-ring { 0%, 100% { transform: translateY(0) rotate(-6deg); } 50% { transform: translateY(-7px) rotate(6deg); } }
  @keyframes il-bub { from { transform: translateY(0); opacity: 0.9; } to { transform: translateY(-60px); opacity: 0; } }
  @keyframes il-pop { from { transform: scale(0); } }
  @keyframes il-grow { from { transform: scaleY(0); } }
  @keyframes il-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
</style>
